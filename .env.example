# Copy this file to `.env` and fill in your bot token.
#   Discord Developer Portal -> Applications -> New Application -> Bot -> Reset Token
DISCORD_TOKEN=replace_me_with_your_bot_token

# Model name registered by create_ollama.ps1
OLLAMA_MODEL=brainrot-bot

# Ollama server (leave as-is for local)
OLLAMA_HOST=http://localhost:11434
